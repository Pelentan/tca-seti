# SETI Phase 1 Environment Variables
# Copy this file to .env and fill in JWT_SECRET
# .env is in .gitignore and must never be committed

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Secret used to sign and verify SETI JWTs
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# Auth mode
# dev  — stub auth, no AD required, dev login form at /dev-login
# production — real OIDC federation via customer AD
# ---------------------------------------------------------------------------
AUTH_MODE=dev

# ---------------------------------------------------------------------------
# Production OIDC only (not needed in dev mode)
# ---------------------------------------------------------------------------
OIDC_REDIRECT_URI=https://localhost:4000/auth/callback
