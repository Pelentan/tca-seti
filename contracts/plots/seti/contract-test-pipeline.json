{
  "name": "Contract Test Pipeline",
  "description": "Triggers a contract test run and verifies results are stored. Tests the complete contract testing pipeline from trigger through policy token issuance through results storage.",
  "application_id": "seti",
  "author": "seti",
  "version": "1.0.0",
  "tags": ["pipeline", "contract-test", "core"],
  "steps": [
    {
      "step_number": 1,
      "description": "Trigger a contract test run via the gateway",
      "method": "POST",
      "path": "/run-contract-test",
      "body": { "application_id": "seti" },
      "expected_status": 200,
      "expected_chain": [
        { "caller": "gateway", "callee": "contract-test", "method": "POST", "path": "/run" }
      ],
      "verify_within_seconds": 10
    },
    {
      "step_number": 2,
      "description": "Verify contract results are accessible",
      "method": "GET",
      "path": "/contract-results",
      "expected_status": 200,
      "expected_chain": [
        { "caller": "gateway", "callee": "results", "method": "GET", "path": "/contract-results" }
      ],
      "verify_within_seconds": 10
    }
  ]
}
