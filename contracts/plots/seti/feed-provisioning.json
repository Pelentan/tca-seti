{
  "name": "Feed Provisioning",
  "description": "Creates a signal feed via Feed Wr4ngler, verifies it exists, then deletes it. Tests the scoped signal delivery provisioning path end-to-end. Feed Wr4ngler is the Elixir OTP service — this plot also verifies the Elixir runtime is stable.",
  "application_id": "seti",
  "author": "seti",
  "version": "1.1.0",
  "tags": ["feed-wrangler", "elixir", "feeds"],
  "steps": [
    {
      "step_number": 1,
      "description": "Create a signal feed for a test wrangler",
      "method": "POST",
      "path": "/feeds",
      "body": {
        "wrangler_id": "plot-test-wr4ngler",
        "clearance_level": "connie-wr4ngler",
        "filters": []
      },
      "expected_status": 201,
      "capture": [
        { "name": "feed_id", "path": "feed_id" }
      ],
      "expected_chain": [
        { "caller": "gateway", "callee": "feed-wrangler", "method": "POST", "path": "/feeds" }
      ],
      "verify_within_seconds": 10
    },
    {
      "step_number": 2,
      "description": "List active feeds and verify creation succeeded",
      "method": "GET",
      "path": "/feeds",
      "expected_status": 200,
      "expected_chain": [
        { "caller": "gateway", "callee": "feed-wrangler", "method": "GET", "path": "/feeds" }
      ],
      "verify_within_seconds": 10
    },
    {
      "step_number": 3,
      "description": "Delete the test feed — no orphans",
      "method": "DELETE",
      "path": "/feeds/{feed_id}",
      "expected_status": 200
    }
  ]
}
