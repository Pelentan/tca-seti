{
    "name": "Plot Lifecycle",
    "description": "Creates a plot and retrieves it. Verifies Plot Store accepts and returns structured plot data correctly. The plot created is intentionally minimal \u2014 it validates the storage mechanism, not the execution pipeline.",
    "application_id": "seti",
    "author": "seti",
    "version": "1.0.0",
    "tags": [
        "plot-store",
        "lifecycle",
        "core"
    ],
    "steps": [
        {
            "step_number": 1,
            "description": "Create a minimal plot in Plot Store",
            "method": "POST",
            "path": "/plots",
            "body": {
                "application_id": "seti",
                "name": "Lifecycle Verification Plot",
                "description": "Created by the Plot Lifecycle plot test to verify storage",
                "author": "plot-test",
                "steps": [
                    {
                        "step_number": 1,
                        "description": "Health check",
                        "method": "GET",
                        "path": "/health",
                        "expected_status": 200,
                        "expected_chain": []
                    }
                ]
            },
            "expected_status": 201,
            "expected_chain": [
                {
                    "caller": "gateway",
                    "callee": "plot-store",
                    "method": "POST",
                    "path": "/plots"
                }
            ],
            "verify_within_seconds": 10,
            "extract_fields": {
                "created_plot_id": "plot_id"
            }
        },
        {
            "step_number": 2,
            "description": "Retrieve the plots list and verify it is non-empty",
            "method": "GET",
            "path": "/plots",
            "expected_status": 200,
            "expected_chain": [
                {
                    "caller": "gateway",
                    "callee": "plot-store",
                    "method": "GET",
                    "path": "/plots"
                }
            ],
            "verify_within_seconds": 10
        },
        {
            "step_number": 3,
            "description": "Delete the lifecycle verification plot \u2014 no orphans",
            "method": "DELETE",
            "path": "/plots/{created_plot_id}",
            "expected_status": 200,
            "expected_chain": [
                {
                    "caller": "gateway",
                    "callee": "plot-store",
                    "method": "DELETE",
                    "path": "/plots/{created_plot_id}"
                }
            ],
            "verify_within_seconds": 10
        }
    ]
}